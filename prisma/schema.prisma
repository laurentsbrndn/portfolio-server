generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SkillCategory {
  HARD
  SOFT
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  fullName    String   @map("full_name") @db.VarChar(100)
  headline    String?  @db.VarChar(150)
  bio         String?
  avatarUrl   String?  @map("avatar_url")
  resumeUrl   String?  @map("resume_url")
  email       String?  @db.VarChar(100)
  phone       String?  @db.VarChar(20)
  location    String?  @db.VarChar(100)
  githubUrl   String?  @map("github_url")
  linkedinUrl String?  @map("linkedin_url")
  websiteUrl  String?  @map("website_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("profile")
}

model Education {
  id           String    @id @default(uuid()) @db.Uuid
  institution  String    @db.VarChar(150)
  degree       String?   @db.VarChar(100)
  fieldOfStudy String?   @map("field_of_study") @db.VarChar(100)
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  isCurrent    Boolean   @default(false) @map("is_current")
  gpa          Decimal?  @db.Decimal(3, 2)
  description  String?
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("education")
}

model WorkExperience {
  id             String    @id @default(uuid()) @db.Uuid
  companyName    String    @map("company_name") @db.VarChar(150)
  companyLogoUrl String?   @map("company_logo_url")
  role           String    @db.VarChar(100)
  employmentType String?   @map("employment_type") @db.VarChar(50)
  location       String?   @db.VarChar(100)
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  isCurrent      Boolean   @default(false) @map("is_current")
  description    String?
  displayOrder   Int       @default(0) @map("display_order")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("work_experience")
}

model Project {
  id               String         @id @default(uuid()) @db.Uuid
  title            String         @db.VarChar(150)
  slug             String         @unique @db.VarChar(150)
  shortDescription String?        @map("short_description")
  fullDescription  String?        @map("full_description")
  thumbnailUrl     String?        @map("thumbnail_url")
  demoUrl          String?        @map("demo_url")
  repositoryUrl    String?        @map("repository_url")
  isFeatured       Boolean        @default(false) @map("is_featured")
  startDate        DateTime?      @map("start_date") @db.Date
  endDate          DateTime?      @map("end_date") @db.Date
  displayOrder     Int            @default(0) @map("display_order")
  createdAt        DateTime       @default(now()) @map("created_at")
  images           ProjectImage[]
  skills           ProjectSkill[]

  @@map("projects")
}

model ProjectImage {
  id           String  @id @default(uuid()) @db.Uuid
  projectId    String  @map("project_id") @db.Uuid
  imageUrl     String  @map("image_url")
  caption      String? @db.VarChar(255)
  displayOrder Int     @default(0) @map("display_order")
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_images")
}

model Skill {
  id               String         @id @default(uuid()) @db.Uuid
  name             String         @db.VarChar(100)
  category         SkillCategory
  proficiencyLevel String?        @map("proficiency_level") @db.VarChar(50)
  iconUrl          String?        @map("icon_url")
  displayOrder     Int            @default(0) @map("display_order")
  projects         ProjectSkill[]

  @@map("skills")
}

model ProjectSkill {
  projectId String  @map("project_id") @db.Uuid
  skillId   String  @map("skill_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@map("project_skills")
}

model OrganizationExperience {
  id               String    @id @default(uuid()) @db.Uuid
  organizationName String    @map("organization_name") @db.VarChar(150)
  role             String    @db.VarChar(100)
  startDate        DateTime  @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  isCurrent        Boolean   @default(false) @map("is_current")
  description      String?
  displayOrder     Int       @default(0) @map("display_order")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("organization_experience")
}

model Language {
  id           String @id @default(uuid()) @db.Uuid
  name         String @db.VarChar(50)
  proficiency  String @db.VarChar(50)
  displayOrder Int    @default(0) @map("display_order")

  @@map("languages")
}

model Certification {
  id                  String    @id @default(uuid()) @db.Uuid
  title               String    @db.VarChar(150)
  issuingOrganization String    @map("issuing_organization") @db.VarChar(150)
  credentialId        String?   @map("credential_id") @db.VarChar(100)
  credentialUrl       String?   @map("credential_url")
  imageUrl            String?   @map("image_url")
  issueDate           DateTime  @map("issue_date") @db.Date
  expirationDate      DateTime? @map("expiration_date") @db.Date
  displayOrder        Int       @default(0) @map("display_order")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@map("certifications")
}